# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_DB=baza
POSTGRES_USER=baza
POSTGRES_PASSWORD=change-me-strong-password
DB_PORT=5434
# Used when running the AI service directly on the host (not in Docker):
DATABASE_URL=postgresql://baza:change-me-strong-password@127.0.0.1:5434/baza

# --- LLM provider: anthropic | gemini | groq ---
LLM_PROVIDER=groq
# Free key at https://console.groq.com/keys
# Gemini instead: LLM_PROVIDER=gemini, ANSWER_MODEL=gemini-2.5-flash, ROUTER_MODEL=gemini-2.5-flash-lite, OCR_MODEL=gemini-2.5-flash (needs billing)
GROQ_API_KEY=
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
ANSWER_MODEL=openai/gpt-oss-120b
# Used when the answer model hits its rate limit (separate quota on Groq)
ANSWER_FALLBACK_MODEL=qwen/qwen3.8-27b
ROUTER_MODEL=openai/gpt-oss-20b
OCR_MODEL=qwen/qwen3.8-27b

# --- Anthropic (when LLM_PROVIDER=anthropic: ANSWER_MODEL=claude-sonnet-5-5, ROUTER_MODEL=claude-haiku-5-5, OCR_MODEL=claude-sonnet-5-5) ---
ANTHROPIC_API_KEY=
# low | medium | high  (low = fastest answers; raise if answer quality needs it)
ANSWER_EFFORT=low

# --- Embeddings (local, no API key; model downloads once, ~2.2 GB) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-large
MODEL_CACHE_DIR=../.cache/models

# --- Services ---
CASE_SERVICE_URL=http://localhost:8081
CASE_SERVICE_TOKEN=change-me-long-random-token
# Key the admin portal sends in the X-Admin-Key header
ADMIN_API_KEY=change-me-long-random-admin-key
# Salt for hashing client IPs (rate limiting / analytics). Keep secret.
CLIENT_HASH_SALT=change-me-random-salt
# Comma-separated origins allowed to call the chat API from a browser
CORS_ORIGINS=http://localhost:8080,https://www.rmb.gov.rw,https://rmb.gov.rw
HTTP_PORT=8080

# --- Admin portal (staff dashboard) ---
# First super admin, created automatically when no staff account exists yet. Change the password after first login.
PORTAL_ADMIN_EMAIL=admin@rmb.local
PORTAL_ADMIN_PASSWORD=change-me-strong-password
PORTAL_ADMIN_NAME=RMB Administrator
# Sessions end after this many idle minutes (and always after 8 hours)
PORTAL_SESSION_MINUTES=30
# true = every staff member must use an authenticator app (recommended in production)
PORTAL_REQUIRE_2FA=false

# --- Production server (docker-compose.prod.yml, scripts/deploy.sh) ---
# development | production  (production: refuses unsafe settings, API docs off)
ENVIRONMENT=development
# Public API + widget host, and the staff portal host (both need HTTPS certificates in nginx/certs/)
PUBLIC_HOST=baza.rmb.gov.rw
PORTAL_HOST=baza-admin.rmb.gov.rw
# Where https://PUBLIC_HOST/ redirects
MAIN_SITE=https://www.rmb.gov.rw
# Conversations not seen for this many days are deleted by the daily purge (0 = keep forever)
CHAT_RETENTION_DAYS=365
# Days of backups kept in backups/ by scripts/backup.sh
BACKUP_KEEP_DAYS=14
# Optional Debian mirror for building the PHP images when deb.debian.org is unreachable
DEBIAN_MIRROR=
