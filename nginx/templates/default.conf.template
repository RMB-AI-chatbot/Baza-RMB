# Production entry point (docker-compose.prod.yml). Variables come from .env:
#   PUBLIC_HOST   public API + widget, e.g. baza.rmb.gov.rw   (called from www.rmb.gov.rw pages)
#   PORTAL_HOST   staff dashboard,     e.g. baza-admin.rmb.gov.rw (RMB network / VPN only, see portal-allow.conf)
#   MAIN_SITE     where "/" on the public host redirects, e.g. https://www.rmb.gov.rw
# Certificates (PEM): /etc/nginx/certs/public.crt + public.key and portal.crt + portal.key
# (a *.rmb.gov.rw wildcard certificate can be used for both; see docs/DEPLOYMENT.md).

limit_req_zone $binary_remote_addr zone=chat:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
limit_req_status 429;

server_tokens off;

# Resolve container names at request time (Docker DNS), so restarting a container never leaves nginx
# pointing at an old address (502 Bad Gateway).
resolver 127.0.0.11 valid=10s ipv6=off;

# --- HTTP: Let's Encrypt challenges, everything else to HTTPS -------------------------------------
server {
    listen 80 default_server;
    server_name _;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

# Unknown host names on HTTPS: close the connection.
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate     /etc/nginx/certs/public.crt;
    ssl_certificate_key /etc/nginx/certs/public.key;
    return 444;
}

# --- Public: chat API and widget ----------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_HOST};

    ssl_certificate     /etc/nginx/certs/public.crt;
    ssl_certificate_key /etc/nginx/certs/public.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 64k;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Frame-Options DENY always;

    location = / { return 302 ${MAIN_SITE}; }

    # The widget script that the RMB website (TYPO3) includes.
    location /widget/ {
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=3600" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location = /api/v1/chat {
        limit_req zone=chat burst=10 nodelay;
        set $ai_upstream http://ai:8000;
        proxy_pass $ai_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_buffering off;          # Server-Sent Events
        proxy_cache off;
        proxy_read_timeout 120s;
    }

    location ~ ^/api/v1/(cases|feedback|widget-config|health)(/|$) {
        limit_req zone=api burst=20 nodelay;
        set $ai_upstream http://ai:8000;
        proxy_pass $ai_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Staff API, docs and anything else: not on the public host.
    location / { return 404; }
}

# --- Staff portal (RMB network only) -------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${PORTAL_HOST};

    ssl_certificate     /etc/nginx/certs/portal.crt;
    ssl_certificate_key /etc/nginx/certs/portal.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;

    include /etc/nginx/portal-allow.conf;   # who may open the staff portal

    client_max_body_size 52m;               # document uploads (PDF, up to 50 MB)
    # Security headers (HSTS, CSP, frame, referrer) are set by the portal itself.

    location = /login {
        limit_req zone=login burst=5 nodelay;
        set $portal_upstream http://portal:80;
        proxy_pass $portal_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        set $portal_upstream http://portal:80;
        proxy_pass $portal_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;            # document re-indexing can take a few minutes
    }
}
